# Порт, на котором запускается сайт
PORT=3000

# Публичный адрес сайта (для sitemap.xml и ссылок в соцсетях), без слеша в конце
SITE_URL=https://cclab.kz

# База PostgreSQL (например, Supabase → Connect → Transaction pooler).
# Если не задано — используется встроенная база в папке DATA_DIR.
DATABASE_URL=

# Папка для встроенной базы (когда DATABASE_URL пустой)
DATA_DIR=./data

# Первый администратор создаётся при первом запуске.
# Если пароль не задан — он будет сгенерирован и выведен в лог сервера.
ADMIN_EMAIL=admin@cclab.kz
ADMIN_PASSWORD=

# Заполнить пустой каталог демо-разработками при первом запуске (1/0)
SEED_DEMO=1

# Поставьте 1, если сайт работает за nginx / Cloudflare / хостингом с прокси
TRUST_PROXY=0

# Уведомления о новых заявках в Telegram (необязательно)
# Токен бота от @BotFather и id чата/группы, куда слать заявки
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
