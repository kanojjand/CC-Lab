{
  "name": "cc-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CC Lab (Code Collective Laboratory) — каталог EdTech-разработок с админ-панелью",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server.js",
