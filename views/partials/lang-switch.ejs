<div class="lang-switch lang-switch--<%= variant %>" role="group" aria-label="<%= t('a11y.lang') %>">
  <% langs.forEach((l) => { %><a href="<%= l.url %>" hreflang="<%= l.hreflang %>" lang="<%= l.hreflang %>" title="<%= l.name %>"<% if (l.code === lang) { %> aria-current="true"<% } %>><%= l.short %></a><% }) %>
</div>
