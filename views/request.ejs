<%- include('partials/top', { title: t('request.title'), description: t('request.description'), canonical: '/request' }) %>
<section class="section">
  <div class="wrap contact-grid">
    <div class="reveal">
      <span class="eyebrow"><%= t('request.eyebrow') %></span>
      <h1 class="h-gap page-title"><%= t('request.heading') %></h1>
      <p class="muted lead-gap"><%= t('request.lead') %></p>
      <%- include('partials/contacts') %>
    </div>
    <div id="request-form" class="reveal" style="--d:1">
      <%- include('partials/lead-form', { product, values, errors, anchor: 'request-form' }) %>
    </div>
  </div>
</section>
<%- include('partials/bottom') %>
