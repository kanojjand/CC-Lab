<%
  const items = [
    ['dashboard', '/admin', 'Обзор'],
    ['products', '/admin/products', 'Разработки'],
    ['categories', '/admin/categories', 'Категории'],
    ['leads', '/admin/leads', 'Заявки'],
    ['settings', '/admin/settings', 'Настройки'],
    ['team', '/admin/team', 'Команда'],
  ];
%><!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title><%= locals.title ? title + ' · ' : '' %>Админка <%= settings.site_name %></title>
<link rel="icon" href="/brand/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&family=Unbounded:wght@500;600&display=swap">
<link rel="stylesheet" href="<%= asset('/css/admin.css') %>">
<script src="<%= asset('/js/admin.js') %>" defer></script>
</head>
<body>
<div class="shell">
  <aside class="side">
    <a class="side-brand" href="/admin"><%- include('../../partials/mark') %><span><b><%= settings.site_name %></b><small>админка</small></span></a>
    <nav class="side-nav" aria-label="Разделы">
      <% items.forEach(([key, href, label]) => { %>
      <a href="<%= href %>"<% if (section === key) { %> aria-current="page"<% } %>><span><%= label %></span><% if (key === 'leads' && newLeads) { %><span class="badge"><%= newLeads %></span><% } %></a>
      <% }) %>
    </nav>
    <div class="side-foot">
      <a class="linkish" href="/" target="_blank" rel="noopener">Открыть сайт ↗</a>
      <span class="who"><%= user.email %></span>
      <form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linkish" type="submit">Выйти</button></form>
    </div>
  </aside>
  <main class="main">
    <% if (flash) { %><div class="flash" role="status">✦ <%= flash %></div><% } %>
