<%- include('partials/top', { title: 'Категории' }) %>
<div class="page-top">
  <div><h1>Категории</h1><p>Разделы каталога: вкладки на странице каталога и плитки на главной.</p></div>
</div>
<% if (error) { %><div class="alert" role="alert"><%= error %></div><% } %>

<div class="two-col">
  <section class="panel">
    <div class="panel-head"><h2>Все категории</h2></div>
    <% if (categories.length) { %>
    <% categories.forEach((c) => { %>
    <form class="panel-body cat-row" method="post" action="/admin/categories/<%= c.id %>">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="row">
        <div class="field"><label for="cn-<%= c.id %>">Название</label><input id="cn-<%= c.id %>" type="text" name="name" value="<%= c.name %>" maxlength="80" required></div>
        <div class="field"><label for="cs-<%= c.id %>">Адрес</label><input id="cs-<%= c.id %>" type="text" name="slug" value="<%= c.slug %>" maxlength="80"></div>
      </div>
      <div class="field"><label for="cd-<%= c.id %>">Описание</label><input id="cd-<%= c.id %>" type="text" name="description" value="<%= c.description %>" maxlength="300"></div>
      <div class="cat-row-foot">
        <div class="field cat-order"><label for="co-<%= c.id %>">Порядок</label><input id="co-<%= c.id %>" type="number" name="sort_order" value="<%= c.sort_order %>"></div>
        <span class="dim"><%= c.count %> <%= plural(c.count, 'разработка', 'разработки', 'разработок') %></span>
        <span class="savebar">
          <a class="btn btn-ghost btn-sm" href="/catalog?category=<%= c.slug %>" target="_blank" rel="noopener">↗</a>
          <button class="btn btn-sm" type="submit">Сохранить</button>
          <button class="btn btn-danger btn-sm" type="submit" formaction="/admin/categories/<%= c.id %>/delete" data-confirm-click="Удалить категорию «<%= c.name %>»? Разработки останутся, но без категории.">Удалить</button>
        </span>
      </div>
    </form>
    <% }) %>
    <% } else { %>
    <div class="empty-state">Категорий пока нет — добавьте первую справа.</div>
    <% } %>
  </section>

  <section class="panel">
    <div class="panel-head"><h2>Новая категория</h2></div>
    <form class="panel-body" method="post" action="/admin/categories">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field"><label for="new-name">Название *</label><input id="new-name" type="text" name="name" maxlength="80" required placeholder="Например, «Комплекты оборудования»"></div>
      <div class="field"><label for="new-desc">Описание</label><input id="new-desc" type="text" name="description" maxlength="300" placeholder="Одна строка для плитки на главной"></div>
      <div class="row">
        <div class="field"><label for="new-slug">Адрес</label><input id="new-slug" type="text" name="slug" maxlength="80" placeholder="из названия"></div>
        <div class="field"><label for="new-order">Порядок</label><input id="new-order" type="number" name="sort_order" value="<%= (categories.length + 1) * 10 %>"></div>
      </div>
      <button class="btn" type="submit">Добавить категорию</button>
    </form>
  </section>
</div>
<%- include('partials/bottom') %>
