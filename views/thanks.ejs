<%- include('partials/top', { title: t('thanks.title'), noindex: true }) %>
<section class="center-page">
  <div class="wrap">
    <div class="big-star" aria-hidden="true"></div>
    <span class="eyebrow"><%= t('thanks.eyebrow') %></span>
    <h1 class="h-gap"><%= t('thanks.heading') %></h1>
    <p><% if (product) { %><%= t('thanks.forProduct', { title: product.title }) %> <% } %><%= t('thanks.text') %></p>
    <div class="hero-actions">
      <a class="btn" href="<%= L('/catalog') %>"><%= t('btn.toCatalog') %> <span class="arrow">→</span></a>
      <a class="btn btn-ghost" href="<%= L('/') %>"><%= t('btn.home') %></a>
    </div>
  </div>
</section>
<%- include('partials/bottom') %>
