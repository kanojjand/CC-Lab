<%
  const p = product;
  const feats = lines(p.features);
  const mods = modules(p.modules);
  const facts = [['product.audience', p.audience], ['product.duration', p.duration], ['product.format', p.format], ['product.code', p.code]]
    .filter(([, v]) => v)
    .map(([k, v]) => [t(k), v]);
%>
<%- include('partials/top', {
  title: p.title,
  description: p.tagline || truncate(p.description, 180),
  image: p.cover ? `/uploads/${p.cover}` : '',
  nav: 'catalog',
  canonical: `/catalog/${p.slug}`,
  noindex: p.status !== 'published',
  editUrl: `/admin/products/${p.id}/edit`,
}) %>
<div class="read-progress" aria-hidden="true"></div>

<div class="wrap">
  <nav class="crumbs" aria-label="<%= t('a11y.crumbs') %>">
    <a href="<%= L('/catalog') %>"><%= t('nav.catalog') %></a><span>/</span>
    <% if (p.category_slug) { %><a href="<%= L(`/catalog?category=${p.category_slug}`) %>"><%= p.category_name %></a><span>/</span><% } %>
    <span><%= p.code %></span>
  </nav>
  <% if (p.status !== 'published') { %>
  <div class="draft-banner"><%= t('product.draft') %> <a href="/admin/products/<%= p.id %>/edit"><%= t('product.openAdmin') %></a></div>
  <% } %>

  <section class="product-hero">
    <div class="product-intro">
      <div class="product-tags">
        <% if (p.category_name) { %><a class="tag tag-solid" href="<%= L(`/catalog?category=${p.category_slug}`) %>"><%= p.category_name %></a><% } %>
        <%# теги ведутся только по-русски — на казахской и английской версиях их не показываем %>
        <% if (lang === 'ru') p.tagList.forEach((tg) => { %><a class="tag" href="<%= L(`/catalog?tag=${encodeURIComponent(tg)}`) %>">#<%= tg %></a><% }) %>
      </div>
      <h1><%= p.title %></h1>
      <% if (p.tagline) { %><p class="product-tagline"><%= p.tagline %></p><% } %>
      <div class="hero-actions">
        <a class="btn" href="#request"><%= t('cta.request') %> <span class="arrow">→</span></a>
        <% if (p.demo_url) { %><a class="btn btn-ghost" href="<%= p.demo_url %>" target="_blank" rel="noopener"><%= t('product.demo') %></a><% } %>
      </div>
    </div>
    <div class="product-media" style="view-transition-name: media-<%= p.id %>">
      <% if (p.cover) { %><img src="/uploads/<%= p.cover %>" alt="<%= p.title %>"><% } else { %><%- coverArt(p.id) %><% } %>
    </div>
  </section>

  <div class="product-layout">
    <div>
      <% if (p.description) { %>
      <section class="block reveal">
        <h2><%= t('product.about') %></h2>
        <div class="prose"><%- md(p.description) %></div>
      </section>
      <% } %>
      <% if (feats.length) { %>
      <section class="block reveal">
        <h2><%= t('product.includes') %></h2>
        <ul class="features"><% feats.forEach((f, i) => { %><li class="reveal" style="--d:<%= i % 4 %>"><%= f %></li><% }) %></ul>
      </section>
      <% } %>
      <% if (mods.length) { %>
      <section class="block reveal">
        <h2><%= t('product.program') %></h2>
        <ol class="modules">
          <% mods.forEach((m, i) => { %>
          <li><span class="idx"><%= String(i + 1).padStart(2, '0') %></span><div><strong><%= m.title %></strong><% if (m.text) { %><span><%= m.text %></span><% } %></div></li>
          <% }) %>
        </ol>
      </section>
      <% } %>
      <% if (p.galleryList.length) { %>
      <section class="block reveal">
        <h2><%= t('product.gallery') %></h2>
        <div class="gallery">
          <% p.galleryList.forEach((img) => { %><a href="/uploads/<%= img %>" target="_blank" rel="noopener"><img src="/uploads/<%= img %>" alt="" loading="lazy"></a><% }) %>
        </div>
      </section>
      <% } %>
    </div>

    <aside class="order-card" aria-label="<%= t('product.orderAria') %>">
      <span class="eyebrow"><%= t('product.price') %></span>
      <div class="price h-gap"><%= fmtPrice(p.price) %></div>
      <% if (p.price_note) { %><span class="price-note"><%= p.price_note %></span><% } %>
      <a class="btn btn-block" href="#request"><%= t('cta.request') %> <span class="arrow">→</span></a>
      <% if (p.demo_url) { %><a class="btn btn-ghost btn-block" href="<%= p.demo_url %>" target="_blank" rel="noopener"><%= t('product.demo') %></a><% } %>
      <% if (facts.length) { %>
      <dl class="facts">
        <% facts.forEach(([k, v]) => { %><div><dt><%= k %></dt><dd><%= v %></dd></div><% }) %>
      </dl>
      <% } %>
    </aside>
  </div>
</div>

<section class="section" id="request">
  <div class="wrap contact-grid">
    <div class="reveal">
      <span class="eyebrow"><%= t('product.request.eyebrow') %></span>
      <h2 class="h-gap"><%= t('product.request.title', { title: p.title }) %></h2>
      <p class="muted lead-gap"><%= t('product.request.lead') %></p>
      <%- include('partials/contacts') %>
    </div>
    <div class="reveal" style="--d:1">
      <%- include('partials/lead-form', { product: p, values, errors, anchor: 'request' }) %>
    </div>
  </div>
</section>

<% if (related.length) { %>
<section class="section">
  <div class="wrap">
    <div class="section-head reveal">
      <div><span class="eyebrow"><%= t('product.related.eyebrow') %></span><h2><%= t('product.related.title') %></h2></div>
      <a class="link-arrow" href="<%= L('/catalog') %>"><%= t('home.allCatalog') %></a>
    </div>
    <div class="grid"><% related.forEach((r, i) => { %><div class="reveal" style="--d:<%= i %>"><%- include('partials/card', { p: r }) %></div><% }) %></div>
  </div>
</section>
<% } %>

<%- include('partials/bottom') %>
