<%- include('partials/top', { canonical: '/' }) %>

<section class="hero" data-hero>
  <div class="wrap hero-inner">
    <div class="hero-copy">
      <span class="eyebrow"><%= settings.site_full_name %></span>
      <h1 class="hero-title"><% settings.hero_title.split(/\s+/).filter(Boolean).forEach((word, i) => { %><span class="w" style="--i:<%= i %>"><%= word %></span> <% }) %></h1>
      <p class="hero-lead"><%= settings.hero_subtitle %></p>
      <div class="hero-actions">
        <a class="btn" href="<%= L('/catalog') %>"><%= t('home.openCatalog') %> <span class="arrow">→</span></a>
        <a class="btn btn-ghost" href="#contacts"><%= t('home.discuss') %></a>
      </div>
      <dl class="hero-stats">
        <div><dd data-count="<%= totalPublished %>"><%= totalPublished %></dd><dt><%= tp(totalPublished, 'home.stat.products') %></dt></div>
        <div><dd data-count="<%= categories.length %>"><%= categories.length %></dd><dt><%= tp(categories.length, 'home.stat.areas') %></dt></div>
        <div><dd>1:1</dd><dt><%= t('home.stat.fit') %></dt></div>
      </dl>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <%- heroRings() %>
      <%- include('partials/mark') %>
    </div>
  </div>
</section>

<% if (categories.length) { %>
<div class="ticker" aria-hidden="true">
  <div class="ticker-track">
    <% for (let i = 0; i < 2; i++) { %><% for (let r = 0; r < 3; r++) { categories.forEach((c) => { %><span><%= c.name %></span><% }) } %><% } %>
  </div>
</div>

<section class="section">
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow"><%= t('home.areas.eyebrow') %></span>
        <h2><%= t('home.areas.title') %></h2>
      </div>
      <a class="link-arrow" href="<%= L('/catalog') %>"><%= t('home.allCatalog') %></a>
    </div>
    <div class="cat-grid">
      <% categories.forEach((c, i) => { %>
      <a class="cat-tile reveal" style="--d:<%= i %>" href="<%= L(`/catalog?category=${c.slug}`) %>">
        <span class="num"><%= String(i + 1).padStart(2, '0') %></span>
        <span class="go" aria-hidden="true">↗</span>
        <h3><%= c.name %></h3>
        <% if (c.description) { %><p><%= c.description %></p><% } %>
        <span class="count"><%= tp(c.count, 'unit.product') %></span>
      </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section">
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow"><%= t('home.featured.eyebrow') %></span>
        <h2><%= t('home.featured.title') %></h2>
      </div>
      <a class="link-arrow" href="<%= L('/catalog') %>"><%= t('home.seeAll') %></a>
    </div>
    <% if (featured.length) { %>
    <div class="grid">
      <% featured.forEach((p, i) => { %><div class="reveal" style="--d:<%= i % 3 %>"><%- include('partials/card', { p }) %></div><% }) %>
    </div>
    <% } else { %>
    <div class="empty">
      <%- include('partials/mark') %>
      <h3><%= t('home.empty.title') %></h3>
      <p><%= t('home.empty.text') %></p>
      <a class="btn" href="<%= L('/request') %>"><%= t('cta.request') %></a>
    </div>
    <% } %>
  </div>
</section>

<section class="section" id="schools">
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow"><%= t('home.schools.eyebrow') %></span>
        <h2><%= t('home.schools.title') %></h2>
        <p><%= t('home.schools.lead') %></p>
      </div>
    </div>
    <ol class="steps">
      <% [1, 2, 3, 4].forEach((n, i) => { %>
      <li class="reveal" style="--d:<%= i %>"><h3><%= t(`home.step${n}.title`) %></h3><p><%= t(`home.step${n}.text`) %></p></li>
      <% }) %>
    </ol>
  </div>
</section>

<section class="section" id="about">
  <div class="wrap about">
    <div class="reveal">
      <span class="eyebrow"><%= t('home.about.eyebrow') %></span>
      <h2 class="h-gap"><%= settings.site_name %> — <%= settings.site_full_name %></h2>
    </div>
    <div class="reveal" style="--d:1">
      <div class="about-text prose"><%- md(settings.about_text) %></div>
      <div class="values">
        <% [1, 2, 3, 4].forEach((n) => { %>
        <div><strong><%= t(`home.value${n}.title`) %></strong><span><%= t(`home.value${n}.text`) %></span></div>
        <% }) %>
      </div>
    </div>
  </div>
</section>

<section class="section" id="contacts">
  <div class="wrap contact-grid">
    <div class="reveal">
      <span class="eyebrow"><%= t('home.contacts.eyebrow') %></span>
      <h2 class="h-gap"><%= t('home.contacts.title') %></h2>
      <p class="muted lead-gap"><%= t('home.contacts.lead') %></p>
      <%- include('partials/contacts') %>
    </div>
    <div class="reveal" style="--d:1" id="request-form">
      <%- include('partials/lead-form', { anchor: 'request-form' }) %>
    </div>
  </div>
</section>

<%- include('partials/bottom') %>
